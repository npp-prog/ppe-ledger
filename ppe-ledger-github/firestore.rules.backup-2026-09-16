rules_version = '2';

// ============================================================
// PPE Ledger — Firestore security rules
//
// Everything in this app (assets, postings, tb_snapshots) is shared
// office data, not per-user data, so the rule is simple: any signed-in
// user (added by an admin in Firebase Console -> Authentication) may
// read and write everything; nobody signed out gets anything.
//
// Deploy with the Firebase CLI:
//   firebase deploy --only firestore:rules
// or paste this file's contents into
//   Firebase Console -> Firestore Database -> Rules -> paste -> Publish
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
