rules_version = '2';

// ============================================================
// PPE Ledger — Firestore security rules
//
// Sept 2026 tightening pass. Previous version (kept alongside this file as
// firestore.rules.backup-2026-09-16) was a single blanket rule: any signed-in
// user could read/write anything, no exceptions. This version:
//
//   1. Denies everything by default — only the collections explicitly
//      matched below are reachable at all. Anything not listed here (a
//      typo'd collection name, a future collection nobody added a rule
//      for yet) is denied, not silently allowed.
//   2. Requires isSignedIn() + isActive() instead of a bare
//      `request.auth != null` — isActive() is an ADDITIVE, opt-in kill
//      switch: it reads that user's own `user_roles/{email}` doc (if one
//      exists) and only blocks them if that doc explicitly sets
//      `active: false`. No existing user_roles doc has that field today,
//      so NOBODY currently signed in is newly blocked by this — it just
//      gives you a lever to disable a departed staff member's Firestore
//      access later without deleting their role doc or touching anything
//      else. (Note: the app's own UI doesn't yet show a friendly "your
//      account was disabled" message for this — a deactivated person would
//      just start seeing generic "couldn't save/load" errors. Worth a
//      small follow-up in the app itself if this gets used for real.)
//   3. Adds basic validation on `assets` writes (the collection actually
//      holding real financial data) — rejects a negative cost/residual
//      value outright. This is intentionally minimal and NON-retroactive:
//      it only ever looks at request.resource.data (the doc as it will be
//      AFTER the write), so it can't reject a write for something already
//      wrong in an existing document; it can only stop a NEW bad value
//      from being introduced.
//   4. Everything else (postings, tb_snapshots, cip_projects, par_ics,
//      ptr_itr, swa_records, user_roles, history_of_repair) keeps today's
//      exact behavior — any signed-in+active user can read/write — since
//      per-tab/per-collection write restrictions were deliberately deferred
//      to a future Cloud Functions migration (see the separate Cloud
//      Functions proposal doc) rather than rebuilt into these rules now.
//
// IMPORTANT — required-field validation on `assets` is scoped to CREATE
// only, not update. Many of the original 245 General Fund assets predate
// this app's item_type/fund unification and were seeded WITHOUT an
// `item_type` or `fund` field at all (the app's own itemTypeOf()/fundAsOf()
// helpers default a missing field to "ppe"/"GF" for exactly this reason).
// Requiring those fields on every update would have silently locked those
// legacy assets out of Revalue/Transfer/Retire/etc. the moment this file
// was published — so update() only re-checks cost/residual, never demands
// a field a legacy doc was never given.
//
// Deploy with the Firebase CLI:
//   firebase deploy --only firestore:rules
// or paste this file's contents into
//   Firebase Console -> Firestore Database -> Rules -> paste -> Publish
//
// Before publishing: diff this against whatever is CURRENTLY live in the
// Console (Firestore Database -> Rules tab shows the live version) — this
// file was drafted without being able to fetch that live version directly,
// so don't assume it matches what's actually deployed today.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- shared helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isActive() {
      let email = request.auth.token.email.lower();
      return !exists(/databases/$(database)/documents/user_roles/$(email))
        || get(/databases/$(database)/documents/user_roles/$(email)).data.get('active', true) == true;
    }
    function isSignedInActive() {
      return isSignedIn() && isActive();
    }

    // ---------- assets: the register's real financial data ----------
    function assetCostValid() {
      return !('cost' in request.resource.data) || request.resource.data.cost == null
        || (request.resource.data.cost is number && request.resource.data.cost >= 0);
    }
    function assetResidualValid() {
      return !('residual_value' in request.resource.data) || request.resource.data.residual_value == null
        || (request.resource.data.residual_value is number && request.resource.data.residual_value >= 0);
    }
    function assetWriteValid() {
      return assetCostValid() && assetResidualValid();
    }
    // Only checked on create() — see the big comment above for why update() doesn't repeat this.
    function assetCreateHasRequiredFields() {
      return request.resource.data.keys().hasAll(['status'])
        && request.resource.data.status in ['active', 'retired'];
    }

    match /assets/{assetId} {
      allow read: if isSignedInActive();
      allow create: if isSignedInActive() && assetWriteValid() && assetCreateHasRequiredFields();
      allow update: if isSignedInActive() && assetWriteValid();
      allow delete: if isSignedInActive();
    }

    // ---------- auditLog: new, append-only from the client's point of view ----------
    // The app only ever calls .add() on this collection (see logAudit() in js/app.js) — update/delete
    // are refused outright here so a written entry can't later be edited or removed by anyone signed
    // in, short of someone with direct Console/Admin-SDK access. Full tamper-resistance (a client
    // literally cannot fabricate or skip an entry) would require moving these writes into a Cloud
    // Function instead of the browser — see the separate Cloud Functions proposal.
    match /auditLog/{entryId} {
      allow read, create: if isSignedInActive();
      allow update, delete: if false;
    }

    // ---------- everything else already in production: unchanged coarse gate ----------
    // Every one of these existed and was reachable under the old blanket rule; this just adds the
    // isActive() check on top of the same "any signed-in user" policy — no other tightening.
    match /postings/{id}          { allow read, write: if isSignedInActive(); }
    match /tb_snapshots/{id}      { allow read, write: if isSignedInActive(); }
    match /cip_projects/{id}      { allow read, write: if isSignedInActive(); }
    match /par_ics/{id}           { allow read, write: if isSignedInActive(); }
    match /ptr_itr/{id}           { allow read, write: if isSignedInActive(); }
    match /swa_records/{id}       { allow read, write: if isSignedInActive(); }
    match /history_of_repair/{id} { allow read, write: if isSignedInActive(); }
    // user_roles deliberately keeps the SAME coarse gate as every other collection (not restricted to
    // admins) — the app's own Access Role feature relies on every signed-in user being able to read
    // the whole collection client-side to compute their own tab access and to render "Users & Roles"
    // for admins; restricting reads here without also reworking that client code would break the
    // Access Role feature for ordinary (non-admin) users. Revisit this once/if that client-side
    // dependency is reworked — see the Cloud Functions proposal's notes on this.
    match /user_roles/{id}        { allow read, write: if isSignedInActive(); }

    // No catch-all match /{document=**} here on purpose — anything not explicitly listed above
    // (a typo'd collection name, a stray top-level doc from old testing/debugging) is denied by
    // default, which is the "deny by default" behavior this rewrite was asked for.
  }
}
